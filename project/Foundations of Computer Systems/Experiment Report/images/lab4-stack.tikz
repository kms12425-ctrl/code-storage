\begin{tikzpicture}[
  stackbox/.style={rectangle, draw, minimum width=5cm, minimum height=0.8cm, align=center},
  font=\small
]
  \node[stackbox, fill=gray!20] (args) at (0, 0) {上级函数栈帧 / 传递参数};
  \node[stackbox, fill=red!20, anchor=north] (ret) at (args.south) {保存的返回地址 (Return Address)};
  \node[stackbox, fill=blue!20, anchor=north] (rbp) at (ret.south) {保存的基址指针 (Saved \%rbp)};
  \node[stackbox, minimum height=2cm, fill=green!10, anchor=north] (buf) at (rbp.south) {缓冲区 (\texttt{buf[32]})\\及编译器分配的对齐填充};
  
  \node[anchor=east, text width=2.5cm, align=right] at ([xshift=-0.5cm]ret.west) {原返回点\\被恶意覆盖};
  \node[anchor=west, text width=2.5cm, align=left] at ([xshift=0.5cm]rbp.east) {在 fizz 攻击中\\被伪造成特定值};
  
  \draw[->, thick, red, dashed] ([xshift=1cm]buf.south) -- ([xshift=1cm]ret.north) node[midway, right, fill=white, inner sep=1pt] {溢出数据};
  \draw[->, thick, red] ([xshift=-3.5cm, yshift=-1cm]buf.south) node[left] {恶意输入 (Payload)} -| ([xshift=-1.5cm]buf.south);
  
\end{tikzpicture}